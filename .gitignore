# Local runs; already-versioned comparison records remain tracked.
/results/
# Optional local manuscript and working documentation.
/paper/
/docs/

# Python environments, caches and build output.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage*
htmlcov/
.venv/
venv/
*.egg-info/
build/
dist/
.ipynb_checkpoints/
.mplconfig/
.cache/

# Generated binary files; only curated data and models are versioned.
*.npz
*.npy
*.pt
*.pkl
*.log
*.tmp
*.lock
/ckpts/
!data/references/**/*.npz
!models/oe_apnn/**/*.pt
!models/oe_apnn/**/history.npz
!models/oe_aprfm/**/*.npz

# Private and machine-specific settings.
.env
.env.*
.vscode/
.idea/
.agents/
.codex/
.aws/
.DS_Store
